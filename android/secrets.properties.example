# Firebase Cloud Messaging (FCM)
# Get this from your Firebase project settings
FIREBASE_API_KEY=your_firebase_api_key_here
FIREBASE_PROJECT_ID=your_firebase_project_id_here
FIREBASE_MESSAGING_SENDER_ID=your_firebase_messaging_sender_id_here
FIREBASE_APP_ID=your_firebase_app_id_here

# MapLibre / Mapbox Configuration
# For self-hosted tiles or MapTiler
MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here
# If using custom tile server, set the URL here
TILE_SERVER_URL=https://your-self-hosted-tiles.example.com/{z}/{x}/{y}.png

# OSRM Server Configuration
# These will be overridden by build variants in NetworkModule.kt
OSRM_DEV_URL=http://router.project-osrm.org/
OSRM_PROD_URL=https://osrm.yourdomain.com/

# Backend API Configuration
# These will be overridden by build variants in NetworkModule.kt
API_DEV_URL=https://dev.api.routeguard.example.com/
API_PROD_URL=https://api.routeguard.example.com/

# JWT Secret (should match backend)
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Google Services Configuration (for google-services.json)
# This file should be placed in app/ directory and NOT committed to version control
# Contains: client_id, api_key, project_number, etc.