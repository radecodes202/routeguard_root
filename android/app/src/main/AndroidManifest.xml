<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.routeguard.android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:name=".RouteGuardApplication"
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.RouteGuard">

        <!-- Hazard Alert Service -->
        <service
            android:name=".notifications.HazardAlertService"
            android:exported="false"
            android:foregroundServiceType="location"/>

        <!-- Firebase Messaging Service -->
        <service
            android:name=".notifications.FcmMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Hazard Alert Dismiss Receiver -->
        <receiver
            android:name=".notifications.HazardAlertDismissReceiver"
            android:exported="false"/>

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.RouteGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".map.HazardMapScreen"
            android:exported="false"
            android:theme="@style/Theme.RouteGuard" />

        <activity
            android:name=".notifications.NotificationScreen"
            android:exported="false"
            android:theme="@style/Theme.RouteGuard" />

        <activity
            android:name=".map.HazardDetailScreen"
            android:exported="false"
            android:theme="@style/Theme.RouteGuard" />

        <activity
            android:name=".report.ReportBottomSheet"
            android:exported="false"
            android:theme="@style/Theme.RouteGuard"
            android:windowSoftInputMode="adjustResize" />

    </application>

</manifest>